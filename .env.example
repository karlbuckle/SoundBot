# Create a bot at https://discord.com/developers/applications and paste its token.
DISCORD_TOKEN=replace-me

# Comma-separated paths inside the container. Each path becomes a collection.
AUDIO_DIRECTORIES=/media/sounds

# Recommended if the site is reachable by anyone else. Leave blank to disable.
WEB_API_TOKEN=choose-a-long-random-value

# Port exposed on the Docker server. The app always uses port 8000 internally.
SOUNDBOARD_PORT=8000

# Compose stores usage analytics in a persistent Docker volume at /data.

# Voice recording ("save the last minute"). Experimental: true rebuilds the
# image with a discord.py fork that can receive Discord's encrypted voice.
# Set back to false and rerun deploy.sh to return to stock discord.py.
ENABLE_RECORDING=false
